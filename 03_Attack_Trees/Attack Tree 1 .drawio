          <mxGeometry height="48" width="60" x="160" y="397" as="geometry" />
        </mxCell>
        <mxCell id="Dubk5IDX2g-jrgfKRCBw-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=7;" value="&lt;b&gt;Step 1&lt;/b&gt;&lt;br&gt;Client secret is exposed in source code, configuration, CI output or an accessible workstation" vertex="1">
          <mxGeometry height="78" width="306" x="37" y="480" as="geometry" />
        </mxCell>
        <mxCell id="Dubk5IDX2g-jrgfKRCBw-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=7;" value="&lt;b&gt;Step 2&lt;/b&gt;&lt;br&gt;Attacker obtains unauthorized access to the exposed secret" vertex="1">
