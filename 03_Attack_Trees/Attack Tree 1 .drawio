          <mxGeometry height="24" width="1000" x="300" y="40" as="geometry" />
        </mxCell>
        <mxCell id="Dubk5IDX2g-jrgfKRCBw-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontColor=#7F1D1D;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;GOAL: Impersonate the authorized AI agent&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:12px&#39;&gt;Obtain an accepted agent identity or credential and use it to access an internal API&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="560" x="520" y="78" as="geometry" />
        </mxCell>
        <mxCell id="Dubk5IDX2g-jrgfKRCBw-4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=16;fontStyle=1;" value="&lt;b&gt;OR&lt;/b&gt;" vertex="1">
