        </mxCell>
        <mxCell id="Dubk5IDX2g-jrgfKRCBw-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;1. Steal OAuth M2M client credentials&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;L = 3 | I = 5 | Risk = 15/25 | &lt;b&gt;High&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="92" width="330" x="25" y="280" as="geometry" />
        </mxCell>
