        </mxCell>
        <mxCell id="Dubk5IDX2g-jrgfKRCBw-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=7;" value="&lt;b&gt;Step 3&lt;/b&gt;&lt;br&gt;The credential is accepted by the token endpoint and yields a service access token" vertex="1">
