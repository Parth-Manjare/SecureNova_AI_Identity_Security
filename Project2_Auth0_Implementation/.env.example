# Auth0 tenant configuration
AUTH0_DOMAIN=securenova-ai-identity-parth-dev.us.auth0.com

# Regular Web Application credentials
AUTH0_CLIENT_ID=your_regular_web_client_id
AUTH0_CLIENT_SECRET=your_rotated_regular_web_client_secret

# SecureNova custom API
AUTH0_API_AUDIENCE=https://api.securenova.ai

# Local application URLs
APP_BASE_URL=http://localhost:8000
AUTH0_CALLBACK_URL=http://localhost:8000/callback

# OAuth scopes
AUTH0_SCOPES=openid profile email read:ai-data

# Session security
SESSION_SECRET=replace_with_a_random_secret

# M2M application
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret

# Second SSO Regular Web Application
AUTH0_SSO_CLIENT_ID=your_sso_client_id
AUTH0_SSO_CLIENT_SECRET=your_sso_client_secret
AUTH0_SSO_CALLBACK_URL=http://localhost:8001/callback

# Optional separate SSO session secret
SSO_SESSION_SECRET=replace_with_a_random_secret

# Local API
SECURENOVA_API_BASE_URL=http://127.0.0.1:8000